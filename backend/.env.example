# ==========================================
# AssistFlow AI - Environment Configuration Example
# Placeholders only. Do NOT commit actual secrets.
# ==========================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5435
DB_USERNAME=assistflow_ai_pro_user
DB_PASSWORD=your_db_password_here
DB_DATABASE=assistflow_ai_pro_db

# Phase 4 & 8: Telegram Notification Delivery
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Phase 5: n8n Workflow Security Secret
N8N_WORKFLOW_SECRET=your_n8n_secret_token_here

# Phase 6: Gemini Natural Language AI
GEMINI_API_KEY=your_gemini_api_key_here

# Phase 7: Google Calendar / Google Meet OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/auth/callback
